# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.pub
private_key*
public_key*
# Exception: Cosign's public key is meant to be distributed/committed --
# that's the entire point of a public key, and anyone verifying a
# platform/security/sign_artifact.sh signature needs it. The blanket
# *.pub rule above exists for defense-in-depth against other, actually
# sensitive *.pub files; it was never meant to catch this one.
!platform/security/keys/cosign.pub

# Locally-generated TLS material (mkcert output — machine-specific, regenerate via
# platform/nginx/scripts/generate_local_certs.sh; *.key above already covers the
# private key, this also excludes the leaf cert so nothing stale gets committed)
platform/nginx/certs/*
!platform/nginx/certs/.gitkeep

# NGINX vhost files generated by platform/compose/deploy.sh promote (derived,
# mutable infra state — same reasoning as gitignoring *.tfstate rather than
# committing it; the audit trail lives in evidence/*/promote_*.json instead)
platform/nginx/conf.d/_generated.*

# Vault init output: unseal keys + root token, the master key to every
# secret Vault holds. Generated by platform/vault/scripts/init_and_unseal.sh.
# Never committed under any circumstance.
platform/vault/.init-output.json

# Identity bootstrap output: generated human passwords + workload role_ids.
# Generated by platform/vault/scripts/setup_identity.sh. The role_ids alone
# would be harmless (they are identifiers, not credentials), but the file
# also carries real passwords, so the whole file is excluded.
platform/vault/.identity-output.json

# Volume backups. Vault's archive is encrypted at rest and useless without
# the unseal keys above, but these are still full copies of platform state
# (Grafana users, API keys) and are large and regenerable. The manifest
# records what was taken; the archives themselves never enter git.
platform/backup/archives/

# Grafana admin credential delivered from Vault by
# platform/observability/scripts/bootstrap_grafana_admin.sh. Disposable and
# regenerable -- Vault is the source of truth, this is only how Compose
# receives it.
platform/observability/.grafana.env

# Raw Trivy scan output (hundreds of KB per scan, fully regenerable from the
# image) -- platform/security/scan_image.sh commits only the small
# trivy_summary_*.json / sbom_summary_*.json derived from these instead.
evidence/*/_raw.trivy_*.json
evidence/*/_raw.sbom_*.json
# Same raw/summary split for the SAST and DAST gates: Semgrep's full JSON
# carries every matched line of source, and ZAP's carries full request and
# response bodies -- both large, both regenerable, and the ZAP one can
# contain whatever the scanned app returned. Only the summaries are evidence
# of record.
evidence/*/_raw.semgrep_*.json
evidence/*/_raw.zap_*.json

# Terraform / OpenTofu
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.d/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.vscode/
*.sublime-*

# OS
.DS_Store
Thumbs.db
.env

