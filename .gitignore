# Sensitive Files (but NOT .env which is above)
*.pfx
*.jks
credentials*.json
secret*.json
token*.json
.aws/
.gcloud/
.azure/

# Model files & large binaries
*.onnx
*.pt
*.pth
*.weights
*.pb
*.h5
*.keras
