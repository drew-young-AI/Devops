# Temporary
.tmp/
tmp/
temp/
*.tmp
*.temp

# Evidence outputs (except committed baseline)
evidence/*/build/
evidence/*/*.log
evidence/*/tmp/

# Node modules (if any)
node_modules/
package-lock.json
yarn.lock

# Transient CI intermediate. run_local_ci.sh writes metadata.json, and
# deploy.sh build renames it to build_<sha>.json -- the named file is the
# evidence of record. A stray metadata.json only appears when CI is invoked
# directly, and committing it would put an unversioned duplicate next to the
# real artifact.
evidence/*/metadata.json

# Baseline copies used by platform/scheduler/install.sh to detect whether a
# plist actually changed. They live next to the plists in ~/Library, not in
# the repo, but the pattern is listed so a stray copy never gets committed.
*.plist.installed
*.plist.new

# Scheduler LIVE STATE, not evidence of record. These rewrite every 15
# minutes, so tracking them means permanent churn and a conflict on every
# branch switch. The append-only records next to them (coverage_gaps.jsonl,
# notifications.jsonl) ARE history and stay tracked -- that is the
# distinction: what happened is worth keeping, what is true right now is not.
evidence/scheduler/*_last.json
evidence/scheduler/logs/

# Generated views. Regenerated on a 15-minute schedule from evidence, so they
# are build output, not source. docs/System-State.html is deliberately NOT
# here: it is hand-curated.
docs/Value-Stream-Board.html
docs/Pipeline-Status.html

# rclone config: the Google Drive OAuth token AND the crypt password. This
# file is the ONLY way to read the offsite backups and is deliberately not
# recoverable from them. Same handling as .init-output.json -- keep a copy in
# a password manager, never in git.
#
# A DIRECTORY, because rclone saves config by renaming a temp file over it,
# which is impossible across a single-file bind mount into the container.
# .replaced-* copies from `setup_rclone.sh --force` are in here too: they
# hold superseded crypt passwords, which are the only way to read archives
# uploaded before the rotation, so they are kept and equally excluded.
platform/backup/.rclone/
# Pre-migration layout. Kept so a leftover file can never be committed.
platform/backup/.rclone.conf
