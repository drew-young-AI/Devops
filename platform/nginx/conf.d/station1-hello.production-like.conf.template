# Template for the production-like vhost — NOT loaded directly by NGINX
# (only conf.d/*.conf is included; this is *.conf.template). The actual file
# is generated by `platform/compose/deploy.sh promote` from this template,
# with __UPSTREAM_PORT__ substituted for whichever blue/green color is
# currently active, and reloaded via `nginx -s reload`.
#
# The generated file (conf.d/_generated.station1-hello.production-like.conf)
# is gitignored — it's derived, mutable infrastructure state, the same
# reasoning platform/iac/ uses to gitignore *.tfstate rather than commit it.
# The audit trail lives in evidence/station1-hello/promote_*.json instead.

upstream station1_hello_productionlike {
  server host.docker.internal:__UPSTREAM_PORT__;
  keepalive 8;
}

server {
  # 8444, not 8443: a distinct listener from the develop vhost
  # (conf.d/station1-hello.conf), published to a separate host port so
  # develop and production-like never share a listener. See
  # platform/compose/README.md for the blue/green port allocation
  # (blue=18081, green=18082).
  listen 8444 ssl;
  listen [::]:8444 ssl;
  http2 on;
  server_name devops.local localhost;

  ssl_certificate     /etc/nginx/certs/devops.local.crt;
  ssl_certificate_key /etc/nginx/certs/devops.local.key;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer-when-downgrade" always;
  # Cross-Origin-Resource-Policy: flagged by platform/security/scan_dast.sh.
  # Without it a cross-origin page can embed this response as a subresource;
  # same-origin, not same-site: this service is never embedded as a
  # cross-origin subresource, so the strictest value is the correct one.
  # ZAP rule 90004 also treats same-site as insufficient, which is what
  # surfaced the question -- the scanner pushed us to the right value
  # rather than merely to a passing one.
  add_header Cross-Origin-Resource-Policy "same-origin" always;

  location / {
    limit_req zone=platform_rl burst=20 nodelay;

    proxy_pass http://station1_hello_productionlike;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id_final;
  }
}
