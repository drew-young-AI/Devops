    {
      "id": 104,
      "type": "timeseries",
      "title": "健康判定的累計分布",
      "description": "全期每種判定各累積了幾份快照。UNKNOWN 是最重要的一條：它代表監測本身壞了，此時「沒有告警」與「一切正常」在位元上完全相同，所以它不能被併進 HEALTHY。",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 15,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "devops_health_verdict_samples_total",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
