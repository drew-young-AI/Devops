{
  "uid": "platform-stages",
  "title": "三線階段燈號",
  "tags": [
    "devops",
    "dataops",
    "mlops",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "description": "三條線的節點狀態與歷程。資料來自 dag.py 的現場探測，經 node-exporter textfile 由 Prometheus 每 15s 抓取。",
  "panels": [
    {
      "type": "stat",
      "title": "DevOps 節點正常",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(devops_node_state_code{node=~\"vault|audit|scheduler|sast|secrets|ci|trivy|registry|k8s|bluegreen|develop|dast|llmreview|gate|prodlike|nginx|prometheus|loki|alertmgr|grafana|backup|restore\"} == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
