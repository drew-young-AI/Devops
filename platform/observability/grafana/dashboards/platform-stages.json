      "type": "stat",
      "title": "DevOps 節點正常",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(devops_node_state{layer!~\"dataops|mlops\",state=\"ok\"} == 1) or vector(0)",
